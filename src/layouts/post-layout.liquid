---
layout: sidebar
---

{% html "head" %}
<style>
    .post {
        .date{
            color: var(--md-sys-color-on-surface-variant);
            font-size: 1rem;
        }

        .title {
            margin-bottom: 0;
            font-size: 3rem;
        }

        .tags{
            list-style: none;
            display: flex;
            padding: 0;
            gap: 1rem;
            flex-wrap: wrap;

            li{
                font-size: 1rem;
                background: var(--md-sys-color-surface-container-high);
                padding: 2px;
                border-radius: 4px;
            }
        }

        .sep{
            width: 100%;
            height: 1px;
            background: var(--md-sys-color-surface-container-highest);
            margin: 1rem 0;
        }

        .author{
            color: var(--md-sys-color-on-surface-variant);
            font-size: 1rem;
        }
    }
</style>
{% endhtml %}

<div class="post">
    <h1 class="title">{{ title }}</h1>
    <span class="date">{{ date | date_to_string }}</span>

    <ul class="tags">
        {% for tag in tags %}
            <li>#{{ tag }}</li>
        {% endfor %}
    </ul>

    <div class="sep"></div>

    {{ content }}


    <div class="sep"></div>

    <div class="author">
        <span>Written by</span>
        <strong class="name">{{ author }}</strong>
    </div>
</div>

